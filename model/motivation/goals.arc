elements:
  architecture-is-ai-native:
    type: goal
    name: Architecture is AI-native
    description: "Architectural decisions are accessible to agents over standard protocols, MCP first."

  governance-is-automated:
    type: goal
    name: Governance is automated
    description: "Fitness functions verify the architecture on every change, in CI and on every surface."

  design-meets-implementation:
    type: goal
    name: Design meets implementation
    description: "The declarative model and what is discovered from the code and the infrastructure reconcile, and drift shows."

  agents-coordinate-through-contracts:
    type: goal
    name: Agents coordinate through contracts
    description: "Architect, developer, tester and release agents work to one set of contracts, the model's."

  ownership-is-cheap:
    type: goal
    name: Ownership is cheap
    description: "Architecture is versioned in git beside the code, not redrawn in diagrams."
